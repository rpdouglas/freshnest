rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Function: Check if user belongs to the Org
    function belongsToOrg(orgId) {
      return request.auth != null && request.auth.token.orgId == orgId;
    }

    // 1. Organizations Collection
    // Read: Allowed if you belong to that Org
    // Write: No one (for now, handled by Admin Scripts)
    match /organizations/{orgId} {
      allow read: if belongsToOrg(orgId);
    }

    // 2. Users Collection
    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Clients Collection (THE FIX)
    // This is the multi-tenant magic.
    match /clients/{clientId} {
      
      // READ: Allow if the existing doc belongs to your Org
      allow read: if belongsToOrg(resource.data.orgId);
      
      // CREATE: Allow if the NEW doc claims to belong to your Org
      allow create: if belongsToOrg(request.resource.data.orgId);
      
      // UPDATE/DELETE: Allow if the existing doc belongs to your Org
      allow update, delete: if belongsToOrg(resource.data.orgId);
    }
  }
}
