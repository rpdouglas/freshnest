rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // 1. Get the requester's Org ID from their User Profile (The Source of Truth)
    function getCurrentUserOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }

    // 2. Check if the resource belongs to the same Org as the user
    function belongsToMyOrg(resourceData) {
      return resourceData.orgId == getCurrentUserOrgId();
    }

    // --- COLLECTION RULES ---

    // 1. USERS (The Fix is Here!)
    match /users/{userId} {
      // Allow user to write ONLY their own profile
      allow create, update: if request.auth.uid == userId; 
      
      // Allow reading if it's YOUR profile OR if the user is in your Org
      allow read: if request.auth.uid == userId || 
                  belongsToMyOrg(resource.data);
    }

    // 2. ORGANIZATIONS
    match /organizations/{orgId} {
      allow read: if orgId == getCurrentUserOrgId();
    }

    // 3. CLIENTS
    match /clients/{clientId} {
      allow read: if belongsToMyOrg(resource.data);
      allow create: if request.resource.data.orgId == getCurrentUserOrgId();
      allow update, delete: if belongsToMyOrg(resource.data);
    }

    // 4. JOBS
    match /jobs/{jobId} {
      allow read: if belongsToMyOrg(resource.data);
      allow create: if request.resource.data.orgId == getCurrentUserOrgId();
      allow update, delete: if belongsToMyOrg(resource.data);
    }

    // 5. INVITES
    match /invites/{inviteId} {
      allow read: if belongsToMyOrg(resource.data);
      allow create: if request.resource.data.orgId == getCurrentUserOrgId();
      allow update, delete: if belongsToMyOrg(resource.data);
    }
  }
}
