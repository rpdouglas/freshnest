rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Function: Check if user belongs to the Org
    function belongsToOrg(orgId) {
      return request.auth != null && request.auth.token.orgId == orgId;
    }

    // 1. Organizations Collection
    match /organizations/{orgId} {
      allow read: if belongsToOrg(orgId);
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Clients Collection
    match /clients/{clientId} {
      allow read: if belongsToOrg(resource.data.orgId);
      allow create: if belongsToOrg(request.resource.data.orgId);
      allow update, delete: if belongsToOrg(resource.data.orgId);
    }

    // 4. Jobs Collection (✨ NEW)
    match /jobs/{jobId} {
      // READ: Allow if the existing job belongs to your Org
      allow read: if belongsToOrg(resource.data.orgId);
      
      // CREATE: Allow if the NEW job claims to belong to your Org
      allow create: if belongsToOrg(request.resource.data.orgId);
      
      // UPDATE/DELETE: Allow if the existing job belongs to your Org
      allow update, delete: if belongsToOrg(resource.data.orgId);
    }
  }
}
